<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.ethan.ai.infrastructure.dao.IAiAgentRuntimeConfigDao">

    <resultMap id="AiAgentRuntimeConfigMap" type="cn.ethan.ai.infrastructure.dao.po.AiAgentRuntimeConfig">
        <id column="id" property="id"/>
        <result column="agent_id" property="agentId"/>
        <result column="client_id" property="clientId"/>
        <result column="max_model_calls" property="maxModelCalls"/>
        <result column="max_tool_calls" property="maxToolCalls"/>
        <result column="status" property="status"/>
    </resultMap>

    <select id="queryByAgentId" parameterType="java.lang.String" resultMap="AiAgentRuntimeConfigMap">
        SELECT id,
               agent_id,
               client_id,
               max_model_calls,
               max_tool_calls,
               status
        FROM ai_agent_runtime_config
        WHERE agent_id = #{agentId}
          AND status = 1
        LIMIT 1
    </select>

</mapper>
