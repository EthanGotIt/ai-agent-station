<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.ethan.ai.infrastructure.dao.AgentStepRunMapper">

    <resultMap id="AgentStepRunMap" type="cn.ethan.ai.infrastructure.dao.po.AgentStepRunPO">
        <id column="id" property="id"/>
        <result column="run_id" property="runId"/>
        <result column="step_id" property="stepId"/>
        <result column="step_name" property="stepName"/>
        <result column="step_order" property="stepOrder"/>
        <result column="step_type" property="stepType"/>
        <result column="status" property="status"/>
        <result column="output_summary" property="outputSummary"/>
        <result column="error_message" property="errorMessage"/>
        <result column="cost_millis" property="costMillis"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert" parameterType="cn.ethan.ai.infrastructure.dao.po.AgentStepRunPO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO agent_step_run (run_id, step_id, step_name, step_order, step_type, status,
                                       output_summary, error_message, cost_millis, start_time, end_time, create_time, update_time)
        VALUES (#{runId}, #{stepId}, #{stepName}, #{stepOrder}, #{stepType}, #{status},
                #{outputSummary}, #{errorMessage}, #{costMillis}, #{startTime}, #{endTime}, #{createTime}, #{updateTime})
    </insert>

</mapper>
