<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.ethan.ai.infrastructure.dao.CheckpointMapper">

    <resultMap id="checkpointResultMap" type="cn.ethan.ai.infrastructure.dao.po.CheckpointPO">
        <id column="id" property="id"/>
        <result column="checkpoint_id" property="checkpointId"/>
        <result column="case_id" property="caseId"/>
        <result column="turn_id" property="turnId"/>
        <result column="step_id" property="stepId"/>
        <result column="ssm_state" property="ssmState"/>
        <result column="state_payload" property="statePayload"/>
        <result column="stage" property="stage"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert" parameterType="cn.ethan.ai.infrastructure.dao.po.CheckpointPO">
        INSERT INTO agent_checkpoint
            (checkpoint_id, case_id, turn_id, step_id, ssm_state, state_payload, stage, created_at)
        VALUES
            (#{checkpointId}, #{caseId}, #{turnId}, #{stepId}, #{ssmState}, #{statePayload}, #{stage}, #{createdAt})
    </insert>

    <select id="selectById" resultMap="checkpointResultMap">
        SELECT id, checkpoint_id, case_id, turn_id, step_id, ssm_state, state_payload, stage, created_at
        FROM agent_checkpoint
        WHERE checkpoint_id = #{checkpointId}
    </select>

</mapper>
