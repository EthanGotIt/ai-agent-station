# 应用端口
SERVER_PORT=8090

# MySQL 连接
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/AI_AGENT_STATION?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# 阿里云百炼；不要将真实密钥提交到仓库
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_AGENT_REACT_BASE_URL=

# 仅允许 qwen3.7 对应角色及其日期快照
AI_AGENT_ROUTER_MODEL=qwen3.7-plus
AI_AGENT_REACT_MODEL=qwen3.7-plus

# 真实模型验收必须由本机显式开启；示例始终保持关闭
AI_AGENT_LIVE_TEST_ENABLED=false

# Router 预算；用于轻量结构化意图判断
AI_AGENT_ROUTER_TIMEOUT=PT15S
AI_AGENT_ROUTER_MAX_OUTPUT_TOKENS=512
AI_AGENT_ROUTER_MAX_RETRIES=0
AI_AGENT_ROUTER_THINKING_ENABLED=true
AI_AGENT_ROUTER_THINKING_BUDGET=512

# AgentScope ReAct 预算；百炼原生工具禁用，外部能力后续仅通过 MCP 接入
AI_AGENT_REACT_TIMEOUT=PT120S
AI_AGENT_REACT_MAX_ITERATIONS=8
AI_AGENT_REACT_MAX_OUTPUT_TOKENS=2048
AI_AGENT_REACT_MAX_RETRIES=1
AI_AGENT_REACT_THINKING_ENABLED=true
AI_AGENT_REACT_THINKING_BUDGET=4096
# 仅在 SPRING_PROFILES_ACTIVE=acceptance 的真实验收环境使用，生产保持 false
AI_AGENT_REACT_ACCEPTANCE_CONFIRMATION_PROBE_ENABLED=false

# 会话记忆：生成与使用可独立开启；默认均关闭
AI_AGENT_MEMORY_GENERATION_ENABLED=false
AI_AGENT_MEMORY_USAGE_ENABLED=false
AI_AGENT_MEMORY_IDLE_DELAY=PT30S
AI_AGENT_MEMORY_EXTRACTION_QUEUE_CAPACITY=64
AI_AGENT_MEMORY_MINIMUM_AUTO_CONFIDENCE=0.75

# 订单适配器；默认使用本地 MyBatis-Plus，HTTP 模式强制应用超时
AI_AGENT_ORDER_GATEWAY=local
AI_AGENT_ORDER_BASE_URL=http://127.0.0.1:18080
AI_AGENT_ORDER_HTTP_TIMEOUT=PT5S
AI_AGENT_ORDER_DIAGNOSIS_SHIPMENT_DELAY_THRESHOLD=PT48H
AI_AGENT_ORDER_DIAGNOSIS_LOGISTICS_STALL_THRESHOLD=PT48H

# 退款渠道；默认本地确定性完成，http 模式用于独立可靠性验收
AI_AGENT_REFUND_CHANNEL_MODE=local
AI_AGENT_REFUND_CHANNEL_BASE_URL=http://127.0.0.1:18081
AI_AGENT_REFUND_CHANNEL_TIMEOUT=PT3S
AI_AGENT_REFUND_WORKER_POLL_INTERVAL=PT5S
AI_AGENT_REFUND_WORKER_INITIAL_DELAY=PT10S
AI_AGENT_REFUND_WORKER_BATCH_SIZE=8
AI_AGENT_REFUND_WORKER_MAX_ATTEMPTS=3
AI_AGENT_REFUND_WORKER_RETRY_DELAY=PT15S
AI_AGENT_REFUND_WORKER_LEASE_DURATION=PT30S

# 请求、Continuation、SSE 与执行线程池资源边界
AI_AGENT_REQUEST_TERMINAL_TTL=PT10M
AI_AGENT_CONTINUATION_TTL=PT30M
AI_AGENT_STREAM_TIMEOUT=PT245S
AI_AGENT_QUEUE_MAX_PENDING_PER_SESSION=4
AI_AGENT_QUEUE_MAX_PENDING_GLOBAL=256
AI_AGENT_QUEUE_WAIT_TIMEOUT=PT2M
AI_AGENT_EXECUTOR_CORE_POOL_SIZE=4
AI_AGENT_EXECUTOR_MAX_POOL_SIZE=16
AI_AGENT_EXECUTOR_QUEUE_CAPACITY=256
AI_AGENT_EXECUTOR_AWAIT_TERMINATION=PT10S
