# Commerce Guardian Agent 本地配置示例
SERVER_PORT=8090

# MySQL 连接；初始化脚本见 docs/dev-ops/mysql/commerce-guardian-agent.sql
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/COMMERCE_GUARDIAN_AGENT?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# DeepSeek；固定使用 deepseek-chat，不启用 thinking；不要提交真实密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_OUTPUT_TOKENS=1024
DEEPSEEK_MAX_ATTEMPTS=1
DEEPSEEK_HTTP_TIMEOUT=PT30S

# Thread Runtime
AI_AGENT_STREAM_TIMEOUT=PT245S
AI_AGENT_QUEUE_MAX_PENDING_PER_THREAD=4
AI_AGENT_QUEUE_MAX_PENDING_GLOBAL=256
AI_AGENT_QUEUE_WAIT_TIMEOUT=PT2M
AI_AGENT_EXECUTOR_CORE_POOL_SIZE=4
AI_AGENT_EXECUTOR_MAX_POOL_SIZE=16
AI_AGENT_EXECUTOR_QUEUE_CAPACITY=256
AI_AGENT_EXECUTOR_AWAIT_TERMINATION=PT10S

# Context 与 Tool Result 预算
AI_AGENT_THREAD_CONTEXT_MAX_ESTIMATED_TOKENS=12000
AI_AGENT_THREAD_SNAPSHOT_TRIGGER_ESTIMATED_TOKENS=9000
AI_AGENT_THREAD_TOOL_RESULT_MAX_CHARACTERS=8000
AI_AGENT_THREAD_OUTPUT_RESERVE_ESTIMATED_TOKENS=1500
AI_AGENT_THREAD_TURN_TIMEOUT=PT4M

# 订单适配器
AI_AGENT_ORDER_GATEWAY=local
AI_AGENT_ORDER_BASE_URL=http://127.0.0.1:18080
AI_AGENT_ORDER_HTTP_TIMEOUT=PT5S

# 外部动作 Worker
AI_AGENT_WORKER_POLL_MILLIS=5000
AI_AGENT_WORKER_INITIAL_DELAY_MILLIS=10000
