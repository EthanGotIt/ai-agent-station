limit_req_zone $binary_remote_addr zone=agent_api:10m rate=${NGINX_API_RATE_LIMIT};

upstream agent_app {
    server app:8090;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name _;

    location = /actuator/health {
        proxy_pass http://agent_app;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name _;

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:TLS:10m;

    client_max_body_size 64k;
    auth_basic "AI Agent Station Demo";
    auth_basic_user_file /etc/nginx/.htpasswd;

    location = /actuator/health {
        auth_basic off;
        proxy_pass http://agent_app;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/ {
        limit_req zone=agent_api burst=${NGINX_API_RATE_BURST} nodelay;
        limit_req_status 429;
        proxy_pass http://agent_app;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 255s;
        proxy_send_timeout 255s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
