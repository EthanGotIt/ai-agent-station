# 复制为 deployment/.env 后填写；禁止提交 deployment/.env。
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DASHSCOPE_API_KEY=

# Nginx 演示访问码；使用独立的随机高强度值。
NGINX_BASIC_AUTH_USERNAME=demo
NGINX_BASIC_AUTH_PASSWORD=
NGINX_API_RATE_LIMIT=30r/m
NGINX_API_RATE_BURST=20

# 默认全部使用 Plus；Max 只能在 V2.1 对照验收后显式启用。
AI_AGENT_ROUTER_MODEL=qwen3.7-plus
AI_AGENT_REACT_MODEL=qwen3.7-plus
AI_AGENT_MEMORY_GENERATION_ENABLED=false
AI_AGENT_MEMORY_USAGE_ENABLED=false
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_AGENT_REACT_BASE_URL=
