#!/bin/sh

repository_root=$(git rev-parse --show-toplevel) || exit 1
cd "$repository_root" || exit 1
export PYTHONUTF8=1

configured_python=$(git config --get hooks.conventionPython)
if [ -n "$configured_python" ] && "$configured_python" -c "import sys" >/dev/null 2>&1; then
    exec "$configured_python" -m scripts.convention_check
fi

if command -v python3 >/dev/null 2>&1 \
    && python3 -c "import sys" >/dev/null 2>&1; then
    exec python3 -m scripts.convention_check
fi

if command -v python >/dev/null 2>&1 \
    && python -c "import sys" >/dev/null 2>&1; then
    exec python -m scripts.convention_check
fi

if command -v py >/dev/null 2>&1 \
    && py -3 -c "import sys" >/dev/null 2>&1; then
    exec py -3 -m scripts.convention_check
fi

echo "未找到 Python 3，无法执行工程规范检查。" >&2
exit 1
